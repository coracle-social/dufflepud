LINKPREVIEW_API_KEY=
MEDIA_ALERT_API_KEY=
MAX_CONTENT_LENGTH=33554432
REDIS_URL=

# Namecoin NIP-05 (.bit domains) -- OPT-IN
# Set at least one of the two backends below to enable `.bit` NIP-05
# resolution. When both are unset, `.bit` handles simply fail to resolve
# (same observable behavior as an unreachable DNS host). Regular DNS-based
# NIP-05 is unaffected. When both are set, RPC is tried first.
#
# Backend 1: namecoind JSON-RPC (trustless; requires running a full node).
# e.g. http://user:pass@127.0.0.1:8336
NAMECOIN_RPC_URL=
#
# Backend 2: ElectrumX (SPV-style; no full node needed). Comma-separated
# list of server URLs. Supported schemes:
#   tcp+tls://host:port  -> raw TCP + TLS (standard Electrum; port 50002)
#   wss://host:port      -> Secure WebSocket (port 50004 typically)
#   tcp://host:port      -> plaintext (discouraged)
# A bare `host:port` is treated as `tcp+tls`. Certificates for known public
# Namecoin ElectrumX servers are pinned. Use the literal value `default`
# to enable the built-in public server list.
# Examples:
#   NAMECOIN_ELECTRUMX_SERVERS=default
#   NAMECOIN_ELECTRUMX_SERVERS=tcp+tls://electrumx.testls.space:50002,wss://my-host.example:50004
NAMECOIN_ELECTRUMX_SERVERS=
