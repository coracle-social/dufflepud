LINKPREVIEW_API_KEY=
MEDIA_ALERT_API_KEY=
MAX_CONTENT_LENGTH=33554432
REDIS_URL=

# Namecoin NIP-05 (.bit / d/ / id/ identifiers) -- OPT-IN
# Set at least one of the two backends below to enable Namecoin
# identifier resolution. When both are unset, .bit / d/ / id/ handles
# fail to resolve (same observable behavior as an unreachable DNS host).
# Regular DNS-based NIP-05 is unaffected. When both are set, RPC is
# tried first and ElectrumX is the fallback.
#
# Backend 1: namecoind JSON-RPC (trustless; requires running a full node).
# e.g. http://user:pass@127.0.0.1:8336
NAMECOIN_RPC_URL=
#
# Backend 2: ElectrumX (SPV-style; no full node needed). Comma-separated
# list of server URLs. Supported schemes:
#   tcp+tls://host:port  -> raw TCP + TLS (standard Electrum; port 50002)
#   wss://host:port      -> Secure WebSocket (port 50004 typically)
#   tcp://host:port      -> plaintext (discouraged)
# A bare `host:port` is treated as `tcp+tls`. The literal value `default`
# expands to the built-in list of public Namecoin ElectrumX servers.
# Examples:
#   NAMECOIN_ELECTRUMX_SERVERS=default
#   NAMECOIN_ELECTRUMX_SERVERS=tcp+tls://electrumx.testls.space:50002,wss://my-host.example:50004
#   NAMECOIN_ELECTRUMX_SERVERS=default,tcp+tls://my-private.example:50002
NAMECOIN_ELECTRUMX_SERVERS=
#
# Optional: additional PEM-encoded server certificates to pin, for
# private ElectrumX deployments with self-signed certs. The two
# well-known public servers are pinned by default. Embed literal
# newlines or use `\n` to separate certs.
NAMECOIN_ELECTRUMX_PINS=
#
# Optional: SOCKS5 proxy for egress anonymity (e.g. Tor). Applies only
# to tcp+tls ElectrumX servers, not WSS. Use alongside
# NAMECOIN_ELECTRUMX_SERVERS=tor for onion-preferred routing. Falls
# back to ALL_PROXY when unset.
#NAMECOIN_SOCKS5_PROXY=socks5://127.0.0.1:9050

# Optional: Namecoin admin endpoints (GET /namecoin/status and
# POST /namecoin/test-server) are disabled unless this token is set.
# Requests must present X-Admin-Token: <value>.
#NAMECOIN_ADMIN_TOKEN=

# Optional resolver tuning (defaults shown):
#NAMECOIN_CONNECT_TIMEOUT=10
#NAMECOIN_READ_TIMEOUT=15
#NAMECOIN_LOOKUP_TIMEOUT=20
#NAMECOIN_CACHE_TTL=3600
#NAMECOIN_CACHE_MAX_ENTRIES=500
#NAMECOIN_SERVER_ERROR_THRESHOLD=3   # consecutive errors before cooldown
#NAMECOIN_SERVER_COOLDOWN=60          # cooldown seconds (0 disables CB)
