LINKPREVIEW_API_KEY=
MEDIA_ALERT_API_KEY=
MAX_CONTENT_LENGTH=33554432
REDIS_URL=

# Namecoin NIP-05 (.bit domains) -- OPT-IN
# When both are unset, `.bit` handles simply fail to resolve (same observable
# behavior as an unreachable DNS host). Regular DNS-based NIP-05 is unaffected.
#
# Trustless mode (recommended): point at your own namecoind JSON-RPC endpoint,
# e.g. http://user:pass@127.0.0.1:8336
NAMECOIN_RPC_URL=

# Alternative: any HTTPS gateway that exposes `GET /{name}` and returns a
# Namecoin `name_show`-compatible JSON object (`{name, value, ...}`).
# Use this when you can't run your own namecoind but trust a third-party node.
NAMECOIN_HTTP_GATEWAY=
